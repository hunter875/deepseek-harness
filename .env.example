# Copy to .env. Keep credentials out of source control. Values are read only
# by the trusted launcher/broker, never forwarded to candidate shell/test.
EDUMATCH_REPO=./edumatch
EDUMATCH_REGION=ap-southeast-1
EDUMATCH_ENVIRONMENT=fixture
EDUMATCH_TARGET=local-fixture
EDUMATCH_STATE_DIR=./.state
EDUMATCH_BROKER_PORT=3091
EDUMATCH_BROKER_TOKEN=
EDUMATCH_POLICY_FILE=./config/policy.json
EDUMATCH_TARGETS_FILE=./config/targets.json

# DeepSeek: populate locally; strict beta remains disabled until live smoke.
DEEPSEEK_API_KEY=
EDUMATCH_DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_THINKING=disabled
DEEPSEEK_API_BUDGET_USD=5

# AWS: create this named profile later. Never use root/admin for observer.
AWS_PROFILE=
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=
AWS_OBSERVER_ROLE_ARN=
AWS_BUILD_ROLE_ARN=
AWS_DEPLOY_ROLE_ARN=
AWS_INSTANCE_ID=
AWS_LOG_GROUP=/edumatch/staging
AWS_MONTHLY_BUDGET_USD=50
AWS_PLANNED_RUNTIME_HOURS=40
AWS_CREATE_RESOURCES_AUTHORIZED=false
AWS_AUTHORIZATION_REF=
AWS_BUDGET_EMAIL=
AWS_AMI_ID=
AWS_INSTANCE_TYPE=t3a.large
AWS_ALLOWED_WEB_CIDR=
AWS_GITHUB_OIDC_PROVIDER_ARN=
AWS_GITHUB_OIDC_SUB=repo:hunter875/edumatch-production:environment:aws-staging
AWS_GITHUB_OIDC_CLAIMS_VERIFIED=false
AWS_TLS_DOMAIN=
AWS_MAX_SESSION_HOURS=4

# Live local observer only after isolation probes pass. Separate read accounts.
OBSERVERS_LIVE_ENABLED=false
EDUMATCH_ISOLATION_ATTESTATION=./artifacts/isolation.json
MATCHING_OBSERVER_DATABASE_URL=
SCHOLARSHIP_OBSERVER_HOST=
SCHOLARSHIP_OBSERVER_PORT=3306
SCHOLARSHIP_OBSERVER_DATABASE=scholarship_db
SCHOLARSHIP_OBSERVER_USERNAME=
SCHOLARSHIP_OBSERVER_PASSWORD=
RABBITMQ_OBSERVER_BASE_URL=
RABBITMQ_OBSERVER_USERNAME=
RABBITMQ_OBSERVER_PASSWORD=
REDIS_OBSERVER_URL=
GITHUB_READ_TOKEN=
GITHUB_MCP_IMAGE=

# Sandbox runner image must be built and pinned before executing candidate code.
SANDBOX_IMAGE=node@sha256:dbcedd8aeab47fbc0f4dd4bffa55b7c3c729a707875968d467aaaea42d6225af
SANDBOX_CPU=2
SANDBOX_MEMORY=2g
SANDBOX_PIDS=128


# Provider budget gateway: dated conservative USD per 1M token ceilings.
# Verify at https://api-docs.deepseek.com/quick_start/pricing/ before live use.
DEEPSEEK_MAX_API_CALLS=24
DEEPSEEK_INPUT_PRICE_CEILING_PER_M=
DEEPSEEK_OUTPUT_PRICE_CEILING_PER_M=
DEEPSEEK_PRICE_VERIFIED_AT=

# Cloud trust/bootstrap. Build and deploy use separate GitHub environments.
AWS_GITHUB_BUILD_OIDC_SUB=repo:hunter875/edumatch-production:environment:aws-staging-build
AWS_OBSERVER_PRINCIPAL_ARN=
AWS_RELEASE_BUCKET=
AWS_BUILD_BASE_IMAGES_JSON=
AWS_PLATFORM_IMAGES_JSON=
AWS_DATA_VOLUME_UUID=
AWS_COMPOSE_BINARY_SHA256=
AWS_RPO_MINUTES=
AWS_RTO_MINUTES=

# Runtime-only secrets: generated into a dedicated subset by runtime-env.mjs.
# They never enter a candidate verifier or diagnostic model process.
AUTH_DB_ROOT_PASSWORD=
AUTH_DB_PASSWORD=
SCHOLARSHIP_DB_ROOT_PASSWORD=
SCHOLARSHIP_DB_PASSWORD=
CHAT_DB_ROOT_PASSWORD=
CHAT_DB_PASSWORD=
MATCHING_DB_PASSWORD=
RABBITMQ_PASSWORD=
EDUMATCH_JWT_SECRET=
EDUMATCH_JWT_PUBLIC_KEY=
EDUMATCH_JWT_PRIVATE_KEY=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_USERNAME=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_STARTTLS_ENABLE=true



# Provider budget gateway: dated conservative USD per 1M token ceilings.
# Verify at https://api-docs.deepseek.com/quick_start/pricing/ before live use.

# Cloud trust/bootstrap. Build and deploy use separate GitHub environments.

# Runtime-only secrets: generated into a dedicated subset by runtime-env.mjs.
# They never enter a candidate verifier or diagnostic model process.
RABBITMQ_USERNAME=



# Provider budget gateway: dated conservative USD per 1M token ceilings.
# Verify at https://api-docs.deepseek.com/quick_start/pricing/ before live use.
GITHUB_OBSERVER_ENABLED=false
GITHUB_TOKEN_SCOPE_VERIFIED=false

# Cloud trust/bootstrap. Build and deploy use separate GitHub environments.

# Runtime-only secrets: generated into a dedicated subset by runtime-env.mjs.
# They never enter a candidate verifier or diagnostic model process.



# Local Harness web UI, independent of the EduMatch frontend on port 3000.
EDUMATCH_UI_PORT=3080
DEEPSEEK_UI_MAX_SECONDS=3600
DEEPSEEK_UI_MAX_TOKENS=1000000
DEEPSEEK_UI_UNLIMITED=false
DEEPSEEK_UI_MAX_REQUEST_BYTES=33554432

# Provider budget gateway: dated conservative USD per 1M token ceilings.
# Verify at https://api-docs.deepseek.com/quick_start/pricing/ before live use.

# Cloud trust/bootstrap. Build and deploy use separate GitHub environments.

# Runtime-only secrets: generated into a dedicated subset by runtime-env.mjs.
# They never enter a candidate verifier or diagnostic model process.
