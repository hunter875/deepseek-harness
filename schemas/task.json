{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion","taskId","state","kind","goal","acceptance","repo","baseRevision","initialSnapshotDigest","environment","targetRef","scope","contracts","commandIds","verifierIds","authorizationRef","allowedCapabilities","unknowns","assumptions","budget"],
  "properties": {
    "schemaVersion": {"const":"1.0"}, "taskId":{"type":"string","pattern":"^task-[a-zA-Z0-9-]+$"},
    "state":{"enum":["DRAFT","FROZEN"]}, "kind":{"enum":["code","diagnostic","review","docs"]}, "goal":{"type":"string","minLength":1},
    "acceptance":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","behavior","source","verifierId","requirement","notApplicableReason"],"properties":{"id":{"type":"string","minLength":1},"behavior":{"type":"string","minLength":1},"source":{"type":"string","minLength":1},"verifierId":{"type":"string","minLength":1},"requirement":{"enum":["required","additional","not-applicable"]},"notApplicableReason":{"type":["string","null"]}}}},
    "repo":{"type":"string","minLength":1},"baseRevision":{"type":["string","null"]},"initialSnapshotDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "environment":{"enum":["fixture","local-shared","aws-staging"]},"targetRef":{"type":"string","minLength":1},
    "scope":{"type":"object","additionalProperties":false,"required":["allowedPaths","services","forbiddenChanges"],"properties":{"allowedPaths":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"services":{"type":"array","items":{"type":"string"}},"forbiddenChanges":{"type":"array","items":{"type":"string"}}}},
    "contracts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","source","sha256"],"properties":{"id":{"type":"string"},"source":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "commandIds":{"type":"array","items":{"type":"string"}},"verifierIds":{"type":"array","minItems":1,"items":{"type":"string"}},
    "authorizationRef":{"type":"string","minLength":1},"allowedCapabilities":{"type":"array","items":{"enum":["read-code","edit-code","fixture-test","observe"]}},
    "unknowns":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["description","impact","verification","blocking"],"properties":{"description":{"type":"string"},"impact":{"type":"string"},"verification":{"type":"string"},"blocking":{"type":"boolean"}}}},
    "assumptions":{"type":"array","items":{"type":"string"}},
    "budget":{"type":"object","additionalProperties":false,"required":["maxSeconds","maxToolCalls","maxTokens","maxCostUsd","maxRepairs"],"properties":{"maxSeconds":{"type":"integer","minimum":1,"maximum":86400},"maxToolCalls":{"type":"integer","minimum":1},"maxTokens":{"type":"integer","minimum":1},"maxCostUsd":{"type":"number","minimum":0},"maxRepairs":{"type":"integer","minimum":0,"maximum":3}}}
  }
}
